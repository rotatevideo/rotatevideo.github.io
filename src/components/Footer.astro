---
---

<footer class="mt-auto w-full bg-[#EEE0C9] dark:bg-[#222D35] border-t-2 border-[#ADC4CE] py-10 px-4 sm:px-6 lg:px-8 transition-colors">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-sm text-[#1E293B] dark:text-[#F1F0E8]">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-[#96B6C5] border border-[#1E293B] flex items-center justify-center font-black text-[#1E293B]" aria-hidden="true">
        ↻
      </div>
      <div>
        <p class="font-extrabold">Rotate Video Online — rotatevideo.github.io</p>
        <p class="text-xs opacity-75">
          100% Client-Side Browser Video Rotator · Zero Server Uploads · MIT License
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-5 font-bold">
      <a href="#workspace" class="hover:underline">Rotator Tool</a>
      <a href="#how-to-rotate-video" class="hover:underline">How to Rotate Video</a>
      <a href="#vlc-comparison" class="hover:underline">VLC Comparison</a>
      <a href="#faq" class="hover:underline">FAQ</a>
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline text-[#1E293B] dark:text-[#96B6C5]"
      >
        Support the Developer ☕
      </a>
      <a
        href="https://github.com/rotatevideo/rotatevideo.github.io"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="RotateVideo GitHub Repository"
        class="hover:underline"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>

<!-- PWA Offline Installation Instructions Modal (Fallback for iOS Safari / Desktop) -->
<div
  id="pwa-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pwa-modal-title"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4"
>
  <div class="w-full max-w-md rounded-3xl bg-[#EEE0C9] dark:bg-[#222D35] border-2 border-[#ADC4CE] p-6 sm:p-8 shadow-2xl text-[#1E293B] dark:text-[#F1F0E8]">
    <div class="flex items-center justify-between gap-4 mb-4">
      <h2 id="pwa-modal-title" class="text-xl sm:text-2xl font-extrabold" data-i18n="pwa_modal_title">
        Install RotateVideo for Offline Use
      </h2>
      <button
        type="button"
        id="pwa-modal-close-icon"
        aria-label="Close installation guide"
        class="p-2 rounded-xl bg-[#F1F0E8] dark:bg-[#182026] hover:bg-[#96B6C5] text-[#1E293B] dark:text-[#F1F0E8]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>
    <p class="text-sm sm:text-base mb-4 leading-relaxed opacity-90" data-i18n="pwa_modal_desc">
      Save RotateVideo to your home screen or desktop to rotate videos anytime with zero internet connection.
    </p>
    <div class="space-y-3 mb-6 text-sm">
      <div class="p-3.5 rounded-2xl bg-[#F1F0E8] dark:bg-[#182026] border border-[#ADC4CE]">
        <p class="font-semibold" data-i18n="pwa_modal_ios">
          iOS / Safari: Tap the Share icon in the browser bar, then select "Add to Home Screen".
        </p>
      </div>
      <div class="p-3.5 rounded-2xl bg-[#F1F0E8] dark:bg-[#182026] border border-[#ADC4CE]">
        <p class="font-semibold" data-i18n="pwa_modal_desktop">
          Desktop Chrome / Edge: Click the install icon in the address bar or open browser menu → "Install Rotate Video Online".
        </p>
      </div>
    </div>
    <button
      type="button"
      id="pwa-modal-close-btn"
      class="w-full py-3.5 rounded-2xl bg-[#96B6C5] hover:bg-[#ADC4CE] text-[#1E293B] font-extrabold text-base transition-colors"
      data-i18n="pwa_modal_close"
    >
      Got It
    </button>
  </div>
</div>
