---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Rotate Video Online Free — Instant 90° & 180° Video Rotator (No Upload)',
  description = 'Video rotate online free in 1 click! Learn how to rotate a video 90° left, 90° right, 180°, or flip MP4, WebM, MOV, and MKV files 100% in your browser. Faster than VLC rotate video tools and any online video editor—zero uploads, zero watermarks, works offline.',
  canonical = 'https://rotatevideo.github.io/',
} = Astro.props;

const keywords =
  'video rotate online free, rotate video online free, rotate video free, how to rotate video online, how to rotate a video, how to rotate video, how rotate video, rotate video vlc, vlc rotate video, crop video online, edit video online, online video editor, video editor online';

const ogImage = 'https://rotatevideo.github.io/og-image.svg';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Rotate Video Online',
  url: 'https://rotatevideo.github.io/',
  description:
    'Rotate video online free directly in your web browser. Instant lossless MP4, MOV, WebM, and MKV rotation (90° clockwise, 90° counter-clockwise, 180° flip, horizontal & vertical mirror) with 100% client-side privacy and offline PWA support.',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires HTML5 Video and JavaScript enabled browser.',
  inLanguage: ['en', 'es', 'pt', 'de', 'fr', 'ja', 'zh', 'ru'],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    'Rotate video 90 degrees clockwise and counter-clockwise',
    'Rotate video 180 degrees upside-down',
    'Flip video horizontally (mirror) and vertically',
    'Instant lossless MP4 and MOV metadata rotation',
    'Universal HTML5 Canvas pixel re-encoding fallback',
    '100% client-side execution with zero server uploads',
    'Offline-capable Progressive Web App (PWA)',
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Rotate a Video Online for Free',
  description:
    'Step-by-step guide on how to rotate video online free (MP4, WebM, MOV, MKV) in your browser without uploading files or losing quality.',
  totalTime: 'PT15S',
  tool: [
    {
      '@type': 'HowToTool',
      name: 'Rotate Video Online Web Application (https://rotatevideo.github.io/)',
    },
  ],
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Drop or Choose Your Video File',
      text: 'Drag and drop your sideways or upside-down MP4, WebM, MOV, or MKV file into the Rotate Video Online box, or click Choose Video File. Your file stays 100% on your device.',
      url: 'https://rotatevideo.github.io/#step-1',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Click Rotate 90° Left, Rotate 90° Right, 180°, or Flip',
      text: 'Use the large one-click controls to rotate your video 90° counter-clockwise, 90° clockwise, 180°, or mirror it horizontally or vertically with real-time hardware-accelerated preview.',
      url: 'https://rotatevideo.github.io/#step-2',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Download Rotated Video Instantly',
      text: 'Click Download Rotated Video to save your corrected video immediately with zero watermarks and zero server upload delay.',
      url: 'https://rotatevideo.github.io/#step-3',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How to rotate video online free without losing quality?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Open https://rotatevideo.github.io/, select your MP4, MOV, WebM, or MKV file, click Rotate 90° Left, Rotate 90° Right, or Rotate 180°, and click Download Rotated Video. Our Smart Lossless engine updates the MP4/MOV transformation matrix directly in your browser in milliseconds with zero quality loss, and also includes a universal pixel re-encoder when mirroring or baking orientation into pixels.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why rotate video online instead of VLC Media Player?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'When you search for rotate video VLC or VLC rotate video, VLC requires navigating Tools → Effects and Filters → Video Effects → Geometry → Transform to preview rotation, and then requires a separate multi-step Convert/Save transcode setup just to save the file permanently. Rotate Video Online lets you rotate and save your video permanently in 3 clicks without installing desktop software.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is it safe to edit video online with this browser video rotator?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Unlike a traditional cloud online video editor or video editor online that uploads your private clips to remote servers, Rotate Video Online runs 100% client-side on your own device using WebAssembly and HTML5 Video APIs. Your video files never leave your computer or phone.',
      },
    },
    {
      '@type': 'Question',
      name: 'How rotate video files on iPhone, Android, Windows, or Mac offline?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Click the "Add to Home Screen" button in the navigation bar to install Rotate Video Online as an offline Progressive Web App (PWA). Once installed, you can rotate video free anytime—even on an airplane or without an internet connection.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I flip or mirror a video horizontally and vertically?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes! In addition to 90° clockwise, 90° counter-clockwise, and 180° rotation, you can click Flip Horizontal (mirror selfie video) or Flip Vertical, preview the transformation smoothly in real time, and export your video.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to crop video online when rotating portrait to landscape?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No cropping is required. When you rotate a 1920x1080 landscape clip by 90°, our engine automatically swaps the output dimensions to 1080x1920 portrait so Not a single pixel is cut off—unlike tools that force you to crop video online.',
      },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://rotatevideo.github.io/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Rotate Video Online Free',
      item: 'https://rotatevideo.github.io/#workspace',
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Tag Manager & GA4 Analytics (Exact Injection) -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-TWT4MB7T"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XS26QQ0DGY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XS26QQ0DGY');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="RotateVideo" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Canonical & Sitemap -->
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Favicon & PWA Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F1F0E8" id="meta-theme-color" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="RotateVideo" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rotate Video Online" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rotate Video Online Free — 90°, 180°, Flip & Mirror in Browser" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Rotate Video Online Free — 100% Client-Side Browser Video Rotator" />

    <!-- JSON-LD Structured Data (WebApplication, HowTo, FAQPage, BreadcrumbList) -->
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- Flash-Free Theme Initialization -->
    <script is:inline>
      (function () {
        try {
          var savedTheme = localStorage.getItem('rotatevideo_theme');
          var metaTheme = document.getElementById('meta-theme-color');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
            if (metaTheme) metaTheme.setAttribute('content', '#182026');
          } else {
            document.documentElement.classList.remove('dark');
            if (metaTheme) metaTheme.setAttribute('content', '#F1F0E8');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#F1F0E8] text-[#1E293B] dark:bg-[#182026] dark:text-[#F1F0E8] antialiased selection:bg-[#96B6C5] selection:text-[#1E293B] transition-colors duration-200 flex flex-col">
    <slot />

    <!-- Register Service Worker for 100% Offline PWA Support -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
